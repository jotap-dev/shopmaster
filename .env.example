APP_NAME=ShopMaster
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# PostgreSQL — esta API é DONA do schema. As migrations em database/migrations/
# são a fonte da verdade; `php artisan migrate` é esperado e obrigatório.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shopmaster
DB_USERNAME=postgres
DB_PASSWORD=

# Banco descartável da suíte de testes (RefreshDatabase). NUNCA aponte para
# o mesmo de DB_DATABASE: a suíte apaga e recria o schema a cada execução.
DB_TEST_DATABASE=shopmaster_test

# -----------------------------------------------------------------------------
# Redis — cache, carrinho de visitante, reserva de estoque, fila e locks.
# Um DB por uso, ver config/database.php.
# `predis` (PHP puro) para não exigir a extensão phpredis compilada.
# -----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CATALOG_DB=2
REDIS_CART_DB=3
REDIS_RESERVATIONS_DB=4
REDIS_QUEUE_DB=5

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# JWT — access token + refresh token de uso único. Sem JWT_SECRET a app cai
# na APP_KEY; em servidor ele é obrigatório (ver docs/deploy.md).
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_ISSUER=shopmaster
JWT_TTL=3600
JWT_REFRESH_TTL=2592000

# -----------------------------------------------------------------------------
# Regras de negócio configuráveis — ver config/shopmaster.php
# -----------------------------------------------------------------------------
SHOPMASTER_CURRENCY=BRL

# Marketplace: percentual retido pela plataforma por linha vendida. A loja
# pode ter um percentual proprio, que prevalece sobre este padrao.
SHOPMASTER_COMMISSION_PERCENTAGE=10.00

# Loja: moderacao ligada faz a loja nascer em `pending_approval`.
# STORE_ROLE_CACHE_TTL e o atraso maximo entre remover um membro e ele
# perder o acesso de fato.
STORE_MAX_PER_USER=5
STORE_REQUIRE_APPROVAL=true
STORE_ROLE_CACHE_TTL=60

CATALOG_CACHE_TTL=300
CATALOG_PAGE_SIZE=24
CART_GUEST_TTL=604800
INVENTORY_RESERVATION_TTL=900
ORDERING_IDEMPOTENCY_TTL=86400

MAIL_MAILER=log
MAIL_FROM_ADDRESS="loja@shopmaster.test"
MAIL_FROM_NAME="${APP_NAME}"
